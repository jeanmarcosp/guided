# Copy to .env.local and fill in. EXPO_PUBLIC_* values are inlined into the app
# bundle — the anon key is safe to ship (Row Level Security is the real guard).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Base URL of the deployed workers/guide-preview worker. Share links become
# https://<this>/share/<token> so they unfurl with a preview card in chat apps.
# Leave unset to fall back to raw guided:// deep links (dev).
# EXPO_PUBLIC_SHARE_URL_BASE=https://guide-preview.YOUR-SUBDOMAIN.workers.dev

# NOTE: the Foursquare key is no longer a client var. Set it as a Supabase
# secret so the edge function can use it:
#   supabase secrets set FOURSQUARE_API_KEY=xxxxxxxx
